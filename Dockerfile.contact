# Contact-form service (stage P2). Builds only entropa-contact.
FROM rust:1-slim-bookworm AS builder
WORKDIR /build
COPY . .
RUN cargo build --release --locked -p entropa-contact

FROM gcr.io/distroless/cc-debian12:nonroot
COPY --from=builder /build/target/release/entropa-contact /usr/local/bin/entropa-contact
ENV PORT=8080
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/entropa-contact"]
