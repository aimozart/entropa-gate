# Copy to .env for local dev. All values here are fake placeholders — never put real
# credentials in this file (it's tracked in git; .env itself is gitignored).
# Every var below is read directly by the code — grep for std::env::var(...) to verify
# this list stays accurate as the codebase changes.

# --- Chain persistence + AI brain (Firestore, Vertex AI) ---
# Unset entirely = runs fully offline: in-memory chain, MockBrain instead of Gemini.
GCP_PROJECT=my-test-project
GCP_REGION=us-central1

# --- Partner API auth for POST /api/tx ---
# "name1:key1,name2:key2" - unset = /api/tx stays open (local/demo default).
ENTROPA_API_KEYS=acme:fake-dev-key-not-real

# --- Metered billing (Stripe) ---
# "name1:cus_xxx,name2:cus_yyy" - a partner with no entry here just isn't billed.
ENTROPA_STRIPE_CUSTOMERS=acme:cus_fake000000000000
STRIPE_SECRET_KEY=sk_test_fake_not_a_real_key

# --- Self-serve signup (Stripe Checkout + webhook) ---
# The metered price customers subscribe to at signup, and the signing secret for
# the Stripe webhook endpoint. Unset = /api/signup returns 503.
ENTROPA_STRIPE_PRICE_ID=price_fake0000000000000
ENTROPA_STRIPE_WEBHOOK_SECRET=whsec_fake_not_a_real_secret

# --- Internal admin panel (/admin) ---
# Unset = every /admin/* route 404s unconditionally (fail-closed by design, L10).
ENTROPA_ADMIN_SECRET=fake-admin-secret-change-me

# --- Outreach/unsubscribe link signing ---
ENTROPA_UNSUBSCRIBE_SECRET=fake-unsubscribe-secret-change-me

# --- Customer dashboard (passwordless email-code login) ---
# Unset = /api/dashboard/{me,regenerate-key,contact} fail closed (503/401), same
# fail-closed posture as the admin panel.
ENTROPA_CUSTOMER_SESSION_SECRET=fake-customer-session-secret-change-me

# --- Gmail domain-wide delegation (login codes + dashboard contact emails) ---
# The full service-account JSON key (as issued by GCP), not just the private key.
# Unset = gmail::send_email fails soft (returns false), logs and moves on.
ENTROPA_GMAIL_SA_KEY={"type":"service_account","client_email":"fake@example.iam.gserviceaccount.com","private_key":"-----BEGIN PRIVATE KEY-----\nfake\n-----END PRIVATE KEY-----\n"}

# --- Probe brain model selection ---
# GeminiBrain (production) vs local ClaudeBrain (offline build-tool only, never deployed).
ENTROPA_MODEL=gemini-2.5-flash-lite
GEMINI_MODEL=gemini-2.5-flash-lite
ANTHROPIC_API_KEY=sk-ant-fake-not-a-real-key

# --- Maintenance mode ---
# Set to any value: serves reads only, starts no writer/leader-lock task at all.
# ENTROPA_MAINTENANCE=1

# K_REVISION is auto-injected by Cloud Run itself - never set this locally.
